				local ang = i * 2.4
				local r = i == 1 and 0 or (3 * size + math.sqrt(i) * 3 * size)
				local at = pos + Vector3.new(math.cos(ang) * r, 3 * size + 1, math.sin(ang) * r)
				model:PivotTo(CFrame.new(at) * CFrame.Angles(0, math.random() * 6.28, 0))
				model.Parent = folder
				table.insert(spawned, model)
				shockwave(at, 6)
			end
		end)
	end

	function ST.pulse()
		if not equipped then
			return
		end
		local res = castAim(S.Range)
		local center = res and (res.Position + res.Normal * 1.5) or (camera.CFrame.Position + camera.CFrame.LookVector * 40)
		local radius = S.PulseRadius
		recoil, flash = 1, 1
		ST.fovKick = 12
		playSound("Fire")
		shockwave(center, radius * 2)
		local params = OverlapParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { player.Character, fxFolder, holder }
		local found = Workspace:GetPartBoundsInRadius(center, radius, params)
		local seen = {}
		for _, p in ipairs(found) do
			local t = resolveTarget(p)
			if t and t.root and not seen[t.root] and t ~= holding then
				seen[t.root] = true
				local away = t.root.Position - center
				local d = away.Magnitude
				local dirv = d > 0.5 and away.Unit or Vector3.yAxis
				local fall = 1 - 0.6 * math.clamp(d / radius, 0, 1)
				local v = (dirv + Vector3.new(0, 0.6, 0)).Unit * S.PulsePower * fall
				if t.humanoid then
					setRagdoll(t, true)
					scheduleRecover(t)
				end
				for _, part in ipairs(collectParts(t)) do
					local r = part.AssemblyRootPart
					if r and not r.Anchored then
						r.AssemblyLinearVelocity = v
						r.AssemblyAngularVelocity = Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * 20
					end
				end
			end
		end
	end
end

local savedCameraMode, savedZoom, savedMinZoom, savedMaxZoom

local function enterFirstPerson()
	if savedCameraMode then
		return
	end
	savedCameraMode = player.CameraMode
	savedMinZoom, savedMaxZoom = player.CameraMinZoomDistance, player.CameraMaxZoomDistance
	local focus = camera.Focus.Position
	savedZoom = math.clamp((camera.CFrame.Position - focus).Magnitude, savedMinZoom, savedMaxZoom)
	player.CameraMode = Enum.CameraMode.LockFirstPerson
end

local function exitFirstPerson()
	if not savedCameraMode then
		return
	end
	local mode, minZ, maxZ = savedCameraMode, savedMinZoom or 0.5, savedMaxZoom or 128
	local zoom = math.clamp(math.max(savedZoom or 12, 10), minZ, math.max(minZ, maxZ))
	savedCameraMode = nil
	player.CameraMode = mode
	if mode ~= Enum.CameraMode.LockFirstPerson then

		player.CameraMinZoomDistance = zoom
		player.CameraMaxZoomDistance = zoom
		task.delay(0.15, function()
			if not savedCameraMode then
				player.CameraMinZoomDistance = minZ
				player.CameraMaxZoomDistance = maxZ
			end
		end)
	end
end

function applyView()
	if not equipped then
		return
	end
	if S.View == 3 then
		enterFirstPerson()
	else
		exitFirstPerson()
	end
end

function toggleView()
	S.View = S.View % #VIEW_NAMES + 1
	for _, f in ipairs(optionRefreshers) do
		f()
	end
	applyView()
	toast("Camera: " .. VIEW_NAMES[S.View], true)
end

