local function holdPosition(t)
	local cf = camera.CFrame
	local off = camHeadOffset()
	local dist = off + holdDist
	local radius = t.radius or 1
	local extra = {}
	if t.model then
		extra[1] = t.model
	else
		for _, p in ipairs(t.parts or {}) do
			table.insert(extra, p)
		end
	end
	rayParams.FilterDescendantsInstances = buildFilter(extra)
	local res = Workspace:Raycast(cf.Position, cf.LookVector * (dist + radius), rayParams)
	if res then
		dist = math.max(off + 1.5, res.Distance - radius)
	end
	return cf.Position + cf.LookVector * dist
end

local function setBeamTarget(part)
