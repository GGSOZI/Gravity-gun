local function boxExtents(list)
	local mnx, mny, mnz = math.huge, math.huge, math.huge
	local mxx, mxy, mxz = -math.huge, -math.huge, -math.huge
	for _, e in ipairs(list) do
		local h = e.size / 2
		for sx = -1, 1, 2 do
			for sy = -1, 1, 2 do
				for sz = -1, 1, 2 do
					local p = e.cf:PointToWorldSpace(Vector3.new(h.X * sx, h.Y * sy, h.Z * sz))
					mnx, mny, mnz = math.min(mnx, p.X), math.min(mny, p.Y), math.min(mnz, p.Z)
					mxx, mxy, mxz = math.max(mxx, p.X), math.max(mxy, p.Y), math.max(mxz, p.Z)
				end
			end
		end
	end
	return Vector3.new(mnx, mny, mnz), Vector3.new(mxx, mxy, mxz)
end

local function isJunk(d)
	return d:IsA("LuaSourceContainer")
		or d:IsA("Sound")
		or d:IsA("Humanoid")
		or d:IsA("ForceField")
		or d:IsA("JointInstance")
		or d:IsA("WeldConstraint")
		or d:IsA("Constraint")
		or d:IsA("TouchTransmitter")
		or d:IsA("Fire")
		or d:IsA("Smoke")
end

local function buildProtos(fetched)

	local function pick(root)
		local tools = {}
		if root:IsA("Tool") then
			table.insert(tools, root)
		end
		for _, d in ipairs(root:GetDescendants()) do
			if d:IsA("Tool") then
				table.insert(tools, d)
			end
		end
		for _, tl in ipairs(tools) do
			local n = tl.Name:lower()
			if n:find("gravity", 1, true) or n:find("gmod", 1, true) or n:find("phys", 1, true) then
				return tl
			end
		end
		for _, tl in ipairs(tools) do
			if not tl.Name:lower():find("portal", 1, true) then
				return tl
			end
		end
		for _, d in ipairs(root:GetDescendants()) do
			if d:IsA("Model") then
				local n = d.Name:lower()
				if n:find("gravity", 1, true) or n:find("gmod", 1, true) then
					return d
				end
			end
		end
		return tools[1] or root
	end
	local toolSrc = pick(fetched)
	local work = Instance.new("Model")
	if toolSrc:IsA("BasePart") then
		toolSrc:Clone().Parent = work
	else
		for _, c in ipairs(toolSrc:GetChildren()) do
			c:Clone().Parent = work
		end
	end
	for _, d in ipairs(work:GetDescendants()) do
		if isJunk(d) then
			d:Destroy()
		end
	end
	local parts = {}
	for _, d in ipairs(work:GetDescendants()) do
		if d:IsA("BasePart") then
			table.insert(parts, d)
		end
	end
	if #parts == 0 then
		work:Destroy()
		return false
	end

	local ref = work:FindFirstChild("Handle", true)
	if ref and not ref:IsA("BasePart") then
		ref = nil
	end
	local base, rot = nil, CFrame.new()
	if ref then
		base = ref.CFrame
	else
		local boxes = {}
		for _, p in ipairs(parts) do
			table.insert(boxes, { cf = p.CFrame, size = p.Size })
		end
		local mn, mx = boxExtents(boxes)
		local size = mx - mn
		base = CFrame.new((mn + mx) / 2)

		if size.X >= size.Y and size.X >= size.Z then
			rot = CFrame.Angles(0, math.rad(90), 0)
		elseif size.Y >= size.Z then
			rot = CFrame.Angles(math.rad(-90), 0, 0)
		end
	end
	local inv = base:Inverse()
	local rels, boxes = {}, {}
	for i, p in ipairs(parts) do
		rels[i] = rot * (inv * p.CFrame)
		boxes[i] = { cf = rels[i], size = p.Size }
	end
	local mn, mx = boxExtents(boxes)
	local size = mx - mn
	local longest = math.max(size.X, size.Y, size.Z)
	if longest < 0.01 then
		work:Destroy()
		return false
	end

	local protos = {}
	for i, p in ipairs(parts) do
		local c = p:Clone()
		for _, d in ipairs(c:GetDescendants()) do
			if d:IsA("BasePart") then
				d:Destroy()
			end
		end
		c.Name = "Gun_" .. p.Name
		c.Anchored = false
		c.CanCollide = false
		c.CanQuery = false
		c.CanTouch = false
		c.Massless = true
		c.CastShadow = false
		protos[i] = { part = c, rel = rels[i], size = p.Size }
	end
	PG.protos = protos
	PG.fit = CONFIG.ModelLength / longest
	PG.tip = Vector3.new((mn.X + mx.X) / 2, (mn.Y + mx.Y) / 2, mn.Z)

	PG.gripSrc = (toolSrc:IsA("Tool") and ref) and toolSrc.Grip or nil
	print("[GravityGun] using '" .. toolSrc.Name .. "' from the asset")
	work:Destroy()
	return true
end

