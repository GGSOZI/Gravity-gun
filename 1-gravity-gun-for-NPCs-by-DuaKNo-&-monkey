local SH = { active = false, ramp = 0, pitch = 0 }
local TP = { alpha = 0, lowered = 0, on = false, char = nil, R = nil, L = nil, frame = nil, autoRotate = nil, run = shared.GG_RUN }

function TP.findArm(char, side)
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum then
		return nil
	end
	if hum.RigType == Enum.HumanoidRigType.R15 then
		local torso = char:FindFirstChild("UpperTorso")
		local upper = char:FindFirstChild(side .. "UpperArm")
		local lower = char:FindFirstChild(side .. "LowerArm")
		local hand = char:FindFirstChild(side .. "Hand")
		local sh = upper and upper:FindFirstChild(side .. "Shoulder")
		if torso and sh and sh:IsA("Motor6D") then
			return {
				motor = sh,
				p0 = torso,
				c0 = sh.C0,
				c1rot = sh.C1.Rotation,
				r15 = true,
				elbow = lower and lower:FindFirstChild(side .. "Elbow"),
				wrist = hand and hand:FindFirstChild(side .. "Wrist"),
			}
		end
	else
		local torso = char:FindFirstChild("Torso")
		local sh = torso and torso:FindFirstChild(side .. " Shoulder")
		if torso and sh and sh:IsA("Motor6D") then
			return { motor = sh, p0 = torso, c0 = sh.C0, c1rot = sh.C1.Rotation, r15 = false }
		end
	end
	return nil
end

function TP.aimArm(arm, dir, alpha)
	local joint = arm.p0.CFrame * arm.c0
	local rot = CFrame.lookAt(Vector3.zero, dir) * CFrame.Angles(math.rad(90), 0, 0)
	local want = arm.p0.CFrame:Inverse() * (CFrame.new(joint.Position) * rot * arm.c1rot)
	arm.motor.C0 = arm.c0:Lerp(want, alpha)
	arm.motor.Transform = arm.motor.Transform:Lerp(CFrame.new(), alpha)

	if arm.elbow then
		arm.elbow.Transform = arm.elbow.Transform:Lerp(CFrame.new(), alpha)
	end
	if arm.wrist then
		arm.wrist.Transform = arm.wrist.Transform:Lerp(CFrame.new(), alpha)
	end
end

function TP.aimPoint()
	rayParams.FilterDescendantsInstances = buildFilter()
	local cf = camera.CFrame
	local res = Workspace:Raycast(cf.Position, cf.LookVector * 600, rayParams)
	return res and res.Position or (cf.Position + cf.LookVector * 600)
end

function TP.aimDirection(origin)
	local cf = camera.CFrame
	local pt = TP.aimPoint()
	local d = pt - origin
	if d.Magnitude < 3 then
		return cf.LookVector
	end
	return d.Unit
end

function TP.clampPitch(dir, lo, hi)
	local el = math.asin(math.clamp(dir.Y, -1, 1))
	local c = math.clamp(el, lo, hi)
	if c == el then
		return dir
	end
	local flat = Vector3.new(dir.X, 0, dir.Z)
	if flat.Magnitude < 0.01 then
		local l = camera.CFrame.LookVector
		flat = Vector3.new(l.X, 0, l.Z)
		if flat.Magnitude < 0.01 then
			flat = Vector3.new(0, 0, -1)
		end
	end
	return (flat.Unit * math.cos(c) + Vector3.yAxis * math.sin(c)).Unit
end

function TP.release()
	for _, arm in ipairs({ TP.R or false, TP.L or false }) do
		if arm and arm.motor.Parent then
			arm.motor.C0 = arm.c0
		end
	end
	local hum = TP.char and TP.char:FindFirstChildOfClass("Humanoid")
	if hum then
		if TP.autoRotate ~= nil then
			hum.AutoRotate = TP.autoRotate
		end
		hum.CameraOffset = Vector3.zero
	end
	if TP.on then
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		UserInputService.MouseIconEnabled = true
	end
	TP.on, TP.frame, TP.R, TP.L, TP.char, TP.autoRotate = false, nil, nil, nil, nil, nil
end

function TP.update(dt)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local ok = hum ~= nil and hrp ~= nil and hum.Health > 0
	local want = equipped and S.View == 2 and ok
	if TP.char and (TP.char ~= char or not ok) then
		TP.release()
	end
	if want and not TP.char then
		TP.char = char
		TP.R = TP.findArm(char, "Right")
		TP.L = TP.findArm(char, "Left")
		TP.autoRotate = hum.AutoRotate
		hum.AutoRotate = false
	end
	TP.alpha = lerp(TP.alpha, want and 1 or 0, 1 - math.exp(-dt * 9))
	if not TP.char then
		TP.frame = nil
		return
	end
	if not want and TP.alpha < 0.03 then
		TP.release()
		return
	end
	TP.on = true

	if want then

		if not hum.Sit then
			local look = camera.CFrame.LookVector
			if SH.active then
				local dd = TP.aimPoint() - (hrp.CFrame * Vector3.new(1.5, 0.5, 0))
				if Vector3.new(dd.X, 0, dd.Z).Magnitude > 6 then
					look = dd
				end
			end
			local flat = Vector3.new(look.X, 0, look.Z)
			if flat.Magnitude > 0.01 then
				local goalRot = CFrame.lookAt(Vector3.zero, flat)
				hrp.CFrame = CFrame.new(hrp.Position) * hrp.CFrame.Rotation:Lerp(goalRot, 1 - math.exp(-dt * 22))
			end
		end

		local goal = S.ShoulderCam and CONFIG.ShoulderOffset or Vector3.zero
		hum.CameraOffset = hum.CameraOffset:Lerp(goal, 1 - math.exp(-dt * 10))
		if not isTouch then
			if panelOpen then
				UserInputService.MouseBehavior = Enum.MouseBehavior.Default
				UserInputService.MouseIconEnabled = true
			else
				UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
				UserInputService.MouseIconEnabled = false
			end
		end
	end

	local R, L = TP.R, TP.L
	if SH.active then
		R, L = nil, nil
	end
	TP.frame = nil
	if R and R.p0.Parent then
		local rj = (R.p0.CFrame * R.c0).Position
		local lj = (L and L.p0.Parent) and (L.p0.CFrame * L.c0).Position or rj
		local mid = (rj + lj) / 2

		TP.lowered = lerp(TP.lowered, holding and 1 or 0, 1 - math.exp(-dt * 8))
		local dir = TP.clampPitch(TP.aimDirection(mid), math.rad(-40 + 15 * TP.lowered), math.rad(35 - 25 * TP.lowered))

		local blend = Vector3.new(0, -1, 0):Lerp(dir, TP.alpha)
		if blend.Magnitude < 0.01 then
			blend = dir
		end
		blend = blend.Unit

		local reach = R.r15 and 2.0 or 1.7
		local lat = (rj - lj).Magnitude / 2
		local fwd = math.sqrt(math.max(reach * reach - lat * lat - 0.09, 0.3))
		local p = mid + blend * fwd + Vector3.new(0, -0.3 - 0.3 * TP.lowered, 0)
		local g = CFrame.lookAt(p, p + blend)
		TP.frame = g

		local len = CONFIG.ModelLength * S.ModelScale
		local handle = (g * CFrame.new(0, -0.3, len * 0.14)).Position
		local trigger = (g * CFrame.new(0, -0.12, -len * 0.14)).Position
		local rightGrip, leftGrip = handle, trigger
		if S.SwapHands then
			rightGrip, leftGrip = trigger, handle
		end
		TP.aimArm(R, (rightGrip - rj).Unit, TP.alpha)
		if L and L.p0.Parent then
			if S.TwoHanded then
				TP.aimArm(L, (leftGrip - lj).Unit, TP.alpha)
			else
				L.motor.C0 = L.c0
			end
		end
	end
end

function SH.start()
	SH.stop()
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hum or hum.RigType ~= Enum.HumanoidRigType.R6 then
		return
	end
	local token = {}
	SH.token = token
	task.spawn(function()
		local function waitFor(obj, name)
			local t0 = os.clock()
			while obj.Parent and not obj:FindFirstChild(name) and os.clock() - t0 < 10 do
				task.wait(0.1)
			end
			return obj:FindFirstChild(name)
		end
		local torso = waitFor(char, "Torso")
		local rArm = waitFor(char, "Right Arm")
		local lArm = waitFor(char, "Left Arm")
		if not (torso and rArm and lArm) then
			return
		end
		local rsh = waitFor(torso, "Right Shoulder")
		local lsh = waitFor(torso, "Left Shoulder")
		local grip = waitFor(rArm, "RightGrip")
		if SH.token ~= token or not equipped or not (rsh and lsh and grip) then
			return
		end
		local rw, lw = Instance.new("Weld"), Instance.new("Weld")
		rsh.Part1 = nil
		lsh.Part1 = nil
		rw.Part0 = torso
		rw.C0 = CFrame.new(1.5, 0.5, 0)
		rw.C1 = CFrame.new(0, 0.5, 0)
		rw.Part1 = rArm
		rw.Parent = torso
		lw.Part0 = torso
		lw.C0 = CFrame.new(-1.5, 0.5, 0)
		lw.C1 = CFrame.new(0, 0.5, 0)
		lw.Part1 = lArm
		lw.Parent = torso
		grip.C0 = CFrame.new(0, -1, -0.5) * CFrame.fromEulerAnglesXYZ(-1.22, -0.45, 0.22)
		SH.char, SH.rsh, SH.lsh, SH.rw, SH.lw, SH.grip = char, rsh, lsh, rw, lw, grip
		SH.ramp = 0
		SH.active = true
	end)
end

function SH.stop()
	SH.token = nil
	if not SH.active then
		return
	end
	SH.active = false
	pcall(function()
		SH.rw:Destroy()
	end)
	pcall(function()
		SH.lw:Destroy()
	end)
	pcall(function()
		if SH.rsh.Parent then
			SH.rsh.Part1 = SH.char["Right Arm"]
		end
	end)
	pcall(function()
		if SH.lsh.Parent then
			SH.lsh.Part1 = SH.char["Left Arm"]
		end
	end)
end

function SH.update(dt)
	if not SH.active then
		return
	end
	local char = SH.char
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not (char and char.Parent and char == player.Character and SH.rw.Parent and hum and hum.Health > 0) then
		SH.stop()
		return
	end
	SH.ramp = math.min(SH.ramp + dt * 3, 1)
	local i = SH.ramp

	local shoulder = SH.rw.Part0.CFrame * Vector3.new(1.5, 0.5, 0)
	local d = TP.aimPoint() - shoulder
	local dir = d.Magnitude > 4 and d.Unit or camera.CFrame.LookVector
	local goal = math.clamp(math.asin(math.clamp(dir.Y, -1, 1)), math.rad(-70), math.rad(70))
	SH.pitch = lerp(SH.pitch, goal, 1 - math.exp(-dt * 16))
	local p = SH.pitch * i
	SH.rw.C0 = CFrame.new(1.5, 0.5, 0.25) * CFrame.fromEulerAnglesXYZ(1.3 * i + p, 0, -0.5 * i)
	SH.lw.C0 = CFrame.new(-1.5, 0.5, 0) * CFrame.fromEulerAnglesXYZ(1.7 * i + p, 0, 0.8 * i)
	SH.lw.C1 = CFrame.new(0.3 * i, 1 + i, 0)
end

