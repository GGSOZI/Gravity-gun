local function fetchSource()
	local manual = ReplicatedStorage:FindFirstChild(CONFIG.ModelFolderName)
	if manual then
		return manual, "ReplicatedStorage"
	end
	local ok, res = pcall(function()
		return game:GetObjects("rbxassetid://" .. CONFIG.GunAssetId)
	end)
	if ok and type(res) == "table" and res[1] then
		return res[1], "GetObjects"
	end
	ok, res = pcall(function()
		return game:GetService("InsertService"):LoadAsset(CONFIG.GunAssetId)
	end)
	if ok and res then
		return res, "InsertService"
	end
	manual = ReplicatedStorage:WaitForChild(CONFIG.ModelFolderName, CONFIG.ModelWaitSeconds)
	if manual then
		return manual, "ReplicatedStorage"
	end
	return nil
end

function PG.applyGrip(live)
	local g = PG.gripSrc
	if g then
		local k = PG.fit * S.ModelScale
		live.tool.Grip = CFrame.new(g.Position * k) * g.Rotation
	else
		live.tool.Grip = PG.grip
	end
end

function PG.attach(live)
	if not PG.protos or live.attached then
		return
	end
	live.attached = true
	for _, e in ipairs(PG.protos) do
		local part = e.part:Clone()
		local weld = Instance.new("Weld")
		weld.Part0 = live.handle
		weld.Part1 = part
		weld.C0 = e.rel
		weld.Parent = live.handle
		part.Parent = live.tool
		table.insert(live.entries, { part = part, weld = weld, rel = e.rel, size = e.size })
	end
	PG.applyGrip(live)
	live.k = nil
	PG.dirty = true
end

function PG.pose(push)
	local live = PG.live
	if not live or not live.attached then
		return
	end
	local k = PG.fit * S.ModelScale
	local adj = CFrame.new(S.ModelX, S.ModelY, S.ModelZ + (push or 0))
		* CFrame.Angles(math.rad(S.ModelPitch), math.rad(S.ModelYaw), math.rad(S.ModelRoll))
	local resize = live.k ~= k
	live.k = k
	if resize then
		PG.applyGrip(live)
	end
	for _, e in ipairs(live.entries) do
		if resize then
			e.part.Size = e.size * k
		end
		e.weld.C0 = adj * (CFrame.new(e.rel.Position * k) * e.rel.Rotation)
	end
	if muzzleAtt then
		muzzleAtt.CFrame = adj * CFrame.new(PG.tip * k)
	end
end

