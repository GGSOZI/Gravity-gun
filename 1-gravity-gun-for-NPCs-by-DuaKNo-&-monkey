local tool
local function ensureTool()
	local backpack = player:FindFirstChildOfClass("Backpack")
	if not backpack then
		return
	end
	if tool then
		local par = tool.Parent
		if par == backpack or (par ~= nil and par == player.Character) then
			return
		end

		local ok = pcall(function()
			tool.Parent = backpack
		end)
		if ok and tool.Parent == backpack then
			return
		end
		pcall(function()
			tool:Destroy()
		end)
	end
	tool = Instance.new("Tool")
	tool.Name = CONFIG.ToolName
	tool.ToolTip = CONFIG.ToolName
	tool.RequiresHandle = true
	tool.CanBeDropped = false
	tool.TextureId = ""
	local okBuild, errBuild = pcall(PG.build, tool)
	if not okBuild then
		warn("[GravityGun] gun model setup failed (tool still given): " .. tostring(errBuild))
	end
	tool.Equipped:Connect(onEquip)
	tool.Unequipped:Connect(onUnequip)
	tool.Parent = backpack
end

