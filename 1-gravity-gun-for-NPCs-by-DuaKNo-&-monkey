		return
	end
	if part then
		PG.beamPart = part
		beamAtt.Parent = PG.beamHolder
		PG.updateBeam()
		beam1.Attachment1 = beamAtt
		beam2.Attachment1 = beamAtt
		beam1.Enabled, beam2.Enabled = true, true
		if PG.beam3 then
			PG.beam3.Attachment1 = beamAtt
			PG.beam3.Enabled = true
		end
	else
