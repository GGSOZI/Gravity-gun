local function releaseHold(skipZeroG)
	if not holding then
		return
	end
	local t = holding
	holding = nil
	holdAP, holdAO = nil, nil
	for _, i in ipairs(holdInstances) do
		i:Destroy()
	end
	table.clear(holdInstances)
	setBeamTarget(nil)
	local ncs = t.noCollides or {}
	task.delay(0.6, function()
		for _, n in ipairs(ncs) do
			n:Destroy()
		end
	end)
	t.noCollides = nil
	claim(t, false)
	if not skipZeroG then
		zeroG(t)
	end
	scheduleRecover(t)
end

local function noCollideSets(char, t)
	local cps = {}
	for _, d in ipairs(char:GetDescendants()) do
		if d:IsA("BasePart") then
			table.insert(cps, d)
		end
	end
	local tps = t.parts
	if #cps * #tps > CONFIG.MaxNoCollide then
		cps = {}
		for _, n in ipairs({ "HumanoidRootPart", "Head", "UpperTorso", "LowerTorso", "Torso" }) do
			local p = char:FindFirstChild(n)
			if p and p:IsA("BasePart") then
				table.insert(cps, p)
			end
		end
		local keep = math.max(1, math.floor(CONFIG.MaxNoCollide / math.max(1, #cps)))
		if #tps > keep then
			local sorted = table.clone(tps)
			table.sort(sorted, function(a, b)
				return a.Size.Magnitude > b.Size.Magnitude
			end)
			tps = table.move(sorted, 1, keep, 1, {})
		end
	end
	return cps, tps
end

local function grab(t)
	stopPull()
	releaseHold(true)
	if t.mass > CONFIG.MaxMass then
		playSound("Deny")
		toast("Too heavy")
		return
	end
	if t.humanoid then
		setRagdoll(t, true)
	end
	t.token = (t.token or 0) + 1
	t.parts = collectParts(t)
	measure(t)
	holding = t
	local base = baseRot(t.humanoid ~= nil)
	t.world = t.root.CFrame.Rotation
	t.rel = base:Inverse() * t.world
	holdDist = math.clamp(S.HoldDefault + t.radius * 0.6, CONFIG.MinHoldDistance, CONFIG.MaxHoldDistance)

	local pAtt = Instance.new("Attachment")
	pAtt.Parent = t.root

	local ap = Instance.new("AlignPosition")
	ap.Mode = Enum.PositionAlignmentMode.TwoAttachment
	ap.Attachment0, ap.Attachment1 = pAtt, holderAtt
	ap.RigidityEnabled = false
	ap.ApplyAtCenterOfMass = true
	ap.MaxForce = math.huge
	ap.MaxVelocity = math.clamp(200 - t.mass * 0.01, 90, 220)
	ap.Responsiveness = S.Snappiness
	ap.Parent = holder

	local ao = Instance.new("AlignOrientation")
	ao.Mode = Enum.OrientationAlignmentMode.TwoAttachment
	ao.Attachment0, ao.Attachment1 = pAtt, holderAtt
	ao.RigidityEnabled = false
	ao.MaxTorque = math.huge
	ao.MaxAngularVelocity = 90
	ao.Responsiveness = math.clamp(S.Snappiness * 0.7, 8, 70)
	ao.Parent = holder

	holdAP, holdAO = ap, ao
	table.insert(holdInstances, pAtt)
	table.insert(holdInstances, ap)
	table.insert(holdInstances, ao)

	t.noCollides = {}
	local char = player.Character
	if char then
		local cpList, tpList = noCollideSets(char, t)
		for _, cp in ipairs(cpList) do
			for _, tp in ipairs(tpList) do
				local nc = Instance.new("NoCollisionConstraint")
				nc.Part0, nc.Part1 = cp, tp
				nc.Parent = holder
				table.insert(t.noCollides, nc)
			end
		end
	end

	setBeamTarget(t.root)
	claim(t, true)
	flash = 0.6
	playSound("Grab")
end

local function startPull(t)
	if t.humanoid then
		setRagdoll(t, true)
	end
	t.token = (t.token or 0) + 1
	pulling = t
	t.pullStartPos = nil
	pullStart = os.clock()
	claim(t, true)
	setBeamTarget(t.root)
	playSound("Grab")
end

local function flingVelocity(dist, dir)
	local g = math.max(Workspace.Gravity, 20)
	local flat = Vector3.new(dir.X, 0, dir.Z)
	if flat.Magnitude < 0.05 then
		local l = camera.CFrame.LookVector
		flat = Vector3.new(l.X, 0, l.Z)
		if flat.Magnitude < 0.05 then
			flat = Vector3.new(0, 0, -1)
		end
	end
	flat = flat.Unit
	local minA, maxA = math.rad(14), math.rad(55)
	local elev = math.asin(math.clamp(dir.Y, -1, 1))
	local theta = math.clamp(elev, minA, maxA)
	local speed = math.min(math.sqrt(math.max(dist, 1) * g / math.sin(2 * theta)), CONFIG.MaxLaunchSpeed)
	local launchDir = dir

	if elev < minA and elev > -math.rad(10) then
		launchDir = flat * math.cos(minA) + Vector3.yAxis * math.sin(minA)
	end
	return launchDir.Unit * speed
end

