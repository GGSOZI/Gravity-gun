local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function buildFilter(extra)
	local list = { fxFolder, holder, tag }
	if player.Character then
		table.insert(list, player.Character)
	end
	if extra then
		for _, i in ipairs(extra) do
			table.insert(list, i)
		end
	end
	return list
end

local function camHeadOffset()
	local head = player.Character and player.Character:FindFirstChild("Head")
	return head and (camera.CFrame.Position - head.Position).Magnitude or 0
end

local function castAim(range)
	rayParams.FilterDescendantsInstances = buildFilter()
	local cf = camera.CFrame
	local off = camHeadOffset()
	local res = Workspace:Raycast(cf.Position, cf.LookVector * (off + range), rayParams)
	return res, off
end

local function collectParts(t)
	local out = {}
	if t.model then
		for _, d in ipairs(t.model:GetDescendants()) do
			if d:IsA("BasePart") then
				table.insert(out, d)
			end
		end
	else
		out = t.root:GetConnectedParts(true)
	end
	return out
end

local function measure(t)
	local mass, radius = 0, 0.5
	for _, p in ipairs(t.parts) do
		mass += p.Mass
		local r = (p.Position - t.root.Position).Magnitude + p.Size.Magnitude * 0.5
		radius = math.max(radius, r)
	end
	t.mass = mass
	t.radius = math.clamp(radius, 0.5, CONFIG.MaxRadius)
end

local frozenStates = setmetatable({}, { __mode = "k" })
local frozenParts = setmetatable({}, { __mode = "k" })

local function resolveTarget(part)
	if not part or not part:IsA("BasePart") then
		return nil
	end
	local fr = frozenParts[part]
	if fr and frozenStates[fr] then
		return frozenStates[fr].t
	end
	local cur = part.Parent
	while cur and cur ~= Workspace do
		if cur:IsA("Model") then
			local hum = cur:FindFirstChildOfClass("Humanoid")
			if hum then
				if Players:GetPlayerFromCharacter(cur) then
					return nil
				end
				local t = npcCache[cur]
				if not t then
					t = { model = cur, humanoid = hum, isPlayer = Players:GetPlayerFromCharacter(cur) ~= nil }
					npcCache[cur] = t
				end
				t.root = hum.RootPart or cur.PrimaryPart or cur:FindFirstChild("HumanoidRootPart")
				if not t.root or t.root.Anchored then
					return nil
				end
				t.parts = collectParts(t)
				measure(t)
				t.name = "NPC"
				return t
			end
		end
		cur = cur.Parent
	end
	if part.Anchored or part:IsGrounded() then
		return nil
	end
	local t = { root = part.AssemblyRootPart }
	if not t.root then
		return nil
	end
	t.parts = collectParts(t)
	t.mass = t.root.AssemblyMass
	measure(t)
	t.mass = math.max(t.mass, 0.01)
	local model = t.root:FindFirstAncestorOfClass("Model")
	t.name = (model and model ~= Workspace and model.Name) or t.root.Name
	return t
end

local function alive(t)
	return t and t.root and t.root:IsDescendantOf(Workspace) and not t.root.Anchored
end

function findTarget(range)
	local res, off = castAim(range)
	local t = res and resolveTarget(res.Instance)
	if t then
		return t, res, off
	end
	if S.AimAssist then
		local radius = isTouch and CONFIG.AimAssistRadiusTouch or CONFIG.AimAssistRadius
		rayParams.FilterDescendantsInstances = buildFilter()
		local cf = camera.CFrame
		local ok, sres = pcall(function()
			return Workspace:Spherecast(cf.Position, radius, cf.LookVector * (off + range), rayParams)
		end)
		if ok and sres then
			local st = resolveTarget(sres.Instance)
			if st then
				return st, sres, off
			end
		end
	end
	return nil, res, off
end

local function snapToRest(model, root)
	local joints = {}
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("JointInstance") and d.Part0 and d.Part1 then
			if d:IsA("Motor6D") then
				d.Transform = CFrame.new()
			end
			table.insert(joints, d)
		end
	end
	local placed = { [root] = true }
	local progress = true
	while progress do
		progress = false
		for _, j in ipairs(joints) do
			local a, b = placed[j.Part0], placed[j.Part1]
			if a and not b then
				j.Part1.CFrame = j.Part0.CFrame * j.C0 * j.C1:Inverse()
				placed[j.Part1] = true
				progress = true
			elseif b and not a then
				j.Part0.CFrame = j.Part1.CFrame * j.C1 * j.C0:Inverse()
				placed[j.Part0] = true
				progress = true
			end
		end
	end
end

local function setRagdoll(t, on)
	local hum, model = t.humanoid, t.model
	if not hum or not model or not model.Parent then
		return
	end
	if on and not S.Ragdoll then
		return
	end
	if on then
		if t.ragdolled then
			return
		end
		t.ragdolled = true
		t.rag, t.motors = {}, {}

		for _, p in ipairs(collectParts(t)) do
			if not frozenParts[p] then
				p.Anchored = false
			end
		end

		t.oldNeck, t.oldBreak = hum.RequiresNeck, hum.BreakJointsOnDeath
		hum.RequiresNeck = false
		hum.BreakJointsOnDeath = false
		hum.PlatformStand = true
		hum:ChangeState(Enum.HumanoidStateType.Physics)
		for _, d in ipairs(t.isPlayer and {} or model:GetDescendants()) do
			if d:IsA("Motor6D") and d.Enabled and d.Part0 and d.Part1 and d.Part0 ~= t.root and d.Part1 ~= t.root then
				local a0 = Instance.new("Attachment")
				a0.CFrame = d.C0
				a0.Parent = d.Part0
				local a1 = Instance.new("Attachment")
				a1.CFrame = d.C1
				a1.Parent = d.Part1
				local bs = Instance.new("BallSocketConstraint")
				bs.Attachment0, bs.Attachment1 = a0, a1
				bs.LimitsEnabled = true
				bs.UpperAngle = 70
				bs.TwistLimitsEnabled = true
				bs.TwistLowerAngle, bs.TwistUpperAngle = -45, 45
				bs.MaxFrictionTorque = 3
				bs.Restitution = 0
				bs.Parent = d.Part0
				local nc = Instance.new("NoCollisionConstraint")
				nc.Part0, nc.Part1 = d.Part0, d.Part1
				nc.Parent = d.Part0
				d.Enabled = false
				table.insert(t.motors, d)
				table.insert(t.rag, a0)
				table.insert(t.rag, a1)
				table.insert(t.rag, bs)
				table.insert(t.rag, nc)
			end
		end
		if #t.motors == 0 then
			t.ragdolled = false
			if not ST.ragWarned then
				ST.ragWarned = true
				toast("Can't ragdoll this NPC: no joints found (is it a normal R6/R15 rig?)")
			end
			return
		end

		local body = {}
		for _, p in ipairs(model:GetChildren()) do
			if p:IsA("BasePart") and p ~= t.root then
				table.insert(body, p)
			end
		end
		if #body <= 17 then
			for a = 1, #body - 1 do
				for b = a + 1, #body do
					local nc = Instance.new("NoCollisionConstraint")
					nc.Part0, nc.Part1 = body[a], body[b]
					nc.Parent = body[a]
					table.insert(t.rag, nc)
				end
			end
		end
		if not ST.ragToasted then
			ST.ragToasted = true
			toast("Ragdoll: " .. #t.motors .. " joints released", true)
		end
	else
		if not t.ragdolled then
			return
		end
		t.ragdolled = false
		for _, i in ipairs(t.rag) do
			i:Destroy()
		end
		if t.oldNeck ~= nil then
			hum.RequiresNeck = t.oldNeck
		end
		if hum.Health <= 0 then
			return
		end
		local root = t.root
		if not root or not root.Parent then
			return
		end

		local rp = RaycastParams.new()
		rp.FilterType = Enum.RaycastFilterType.Exclude
		rp.FilterDescendantsInstances = { model, fxFolder, holder, player.Character }
		local res = Workspace:Raycast(root.Position + Vector3.new(0, 3, 0), Vector3.new(0, -400, 0), rp)
		local height
		if hum.RigType == Enum.HumanoidRigType.R15 then
			height = hum.HipHeight + root.Size.Y / 2
		else
			local leg = model:FindFirstChild("Left Leg")
			height = (leg and leg.Size.Y or 2) + root.Size.Y / 2
		end
		local inAir = (not res) or (root.Position.Y - res.Position.Y) > height + 3
		local y = inAir and root.Position.Y or (res.Position.Y + height + 0.15)
		local look = root.CFrame.LookVector
		local flat = Vector3.new(look.X, 0, look.Z)
		local yaw = flat.Magnitude > 0.2 and math.atan2(-look.X, -look.Z) or (t.lastYaw or 0)
		t.lastYaw = yaw

		local parts = collectParts(t)
		for _, p in ipairs(parts) do
			p.Anchored = true
			p.AssemblyLinearVelocity = Vector3.zero
			p.AssemblyAngularVelocity = Vector3.zero
		end
		root.CFrame = CFrame.new(root.Position.X, y, root.Position.Z) * CFrame.Angles(0, yaw, 0)
		snapToRest(model, root)
		for _, m in ipairs(t.motors) do
			if m.Parent then
				m.Enabled = true
			end
		end
		hum.PlatformStand = false
		task.delay(0.1, function()
			if t.ragdolled or not model.Parent then
				return
			end
			for _, p in ipairs(parts) do
				if p.Parent and not frozenParts[p] then
					p.Anchored = false
					p.AssemblyLinearVelocity = Vector3.zero
					p.AssemblyAngularVelocity = Vector3.zero
				end
			end
			hum:ChangeState(Enum.HumanoidStateType.GettingUp)
		end)
	end
end

local function scheduleRecover(t)
	if not t.humanoid then
		return
	end
	t.token = (t.token or 0) + 1
	local tok = t.token
	task.spawn(function()
		task.wait(CONFIG.RagdollTime)

		local waited = 0
		while t.token == tok and waited < 12 and t.root and t.root.Parent and t.root.AssemblyLinearVelocity.Magnitude > 10 do
			task.wait(0.25)
			waited += 0.25
		end
		if t.token == tok and holding ~= t and pulling ~= t then
			setRagdoll(t, false)
		end
	end)
end

local function shockwave(pos, size)
	local p = Instance.new("Part")
	p.Shape = Enum.PartType.Ball
	p.Size = Vector3.one
	p.Material = Enum.Material.Neon
	p.Color = accent
	p.Transparency = 0.35
	p.Anchored = true
	p.CanCollide, p.CanQuery, p.CanTouch = false, false, false
	p.CastShadow = false
	p.Position = pos
	p.Parent = Workspace
	TweenService:Create(
		p,
		TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Size = Vector3.one * size, Transparency = 1 }
	):Play()
	Debris:AddItem(p, 0.5)
end

local function zeroG(t)
	if not S.ZeroG or not t.root or not t.root.Parent then
		return
	end
	local att = Instance.new("Attachment")
	att.Parent = t.root
	local vf = Instance.new("VectorForce")
	vf.Attachment0 = att
	vf.RelativeTo = Enum.ActuatorRelativeTo.World
	vf.ApplyAtCenterOfMass = true
	vf.Force = Vector3.new(0, t.root.AssemblyMass * Workspace.Gravity, 0)
	vf.Parent = t.root
	Debris:AddItem(att, S.ZeroGTime)
	Debris:AddItem(vf, S.ZeroGTime)
end

local function baseRot(isNpc)
	local cf = camera.CFrame
	if isNpc then
		local l = cf.LookVector
		local flat = Vector3.new(l.X, 0, l.Z)
		if flat.Magnitude < 0.01 then
			return CFrame.new()
		end
		return CFrame.lookAt(Vector3.zero, flat)
	end
	return cf.Rotation
end

local function heldRotation(t)
	local base = baseRot(t.humanoid ~= nil)
	if S.FollowCamera then
		t.world = base * t.rel
	else
		t.rel = base:Inverse() * t.world
	end
	return t.world
end

local function rotateHeld(t, axis, angle)
	if math.abs(angle) < 1e-6 then
		return
	end
	local cur = heldRotation(t)
	local new = (CFrame.fromAxisAngle(axis, angle) * cur):Orthonormalize()
	t.world = new
	t.rel = baseRot(t.humanoid ~= nil):Inverse() * new
end

local function axisVec(kind)
	local cf = camera.CFrame
	if kind == 1 then
		return cf.UpVector
	elseif kind == 2 then
		return cf.RightVector
	elseif kind == 3 then
		return cf.LookVector
	end
	return (cf.UpVector + cf.RightVector * 0.6 + cf.LookVector * 0.35).Unit
end

