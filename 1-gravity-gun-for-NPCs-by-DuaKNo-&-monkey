function ARC.hide()
	ARC.shown = false
	for _, p in ipairs(ARC.parts) do
		p.Transparency = 1
	end
	ARC.ring.Transparency = 1
end

function ARC.update(t)
	local dist = t.humanoid and S.NpcDistance or S.ObjectDistance
	local v = flingVelocity(dist, camera.CFrame.LookVector)
	local g = math.max(Workspace.Gravity, 20)
	local p0 = t.root.Position
	local total = math.clamp(2 * math.max(v.Y, 8) / g * 1.25, 0.6, 10)
	local extra = {}
	if t.model then
		extra[1] = t.model
	else
		for _, p in ipairs(t.parts or {}) do
			table.insert(extra, p)
		end
	end
	rayParams.FilterDescendantsInstances = buildFilter(extra)
	local n = #ARC.parts
	local prev = p0
	local hit = nil
	for i = 1, n do
		local part = ARC.parts[i]
		if hit then
			part.Transparency = 1
		else
			local tt = total * i / n
			local pos = p0 + v * tt + Vector3.new(0, -0.5 * g * tt * tt, 0)
			local seg = pos - prev
			local res = seg.Magnitude > 0.01 and Workspace:Raycast(prev, seg, rayParams) or nil
			if res then
				hit = res
				part.Position = res.Position
			else
				part.Position = pos
			end
			part.Transparency = 0.2 + 0.5 * (i / n)
			prev = pos
		end
	end
	if hit then
		ARC.ring.CFrame = CFrame.lookAt(hit.Position, hit.Position + hit.Normal) * CFrame.Angles(0, math.rad(90), 0)
		ARC.ring.Transparency = 0.35
	else
		ARC.ring.Transparency = 1
	end
	ARC.shown = true
end

local function launch(t, dir, spinAxis)
	if frozenStates[t.root] then
		toast("Frozen - press G to unfreeze first")
		return
	end
	local factor = math.clamp(1 - t.mass / (CONFIG.PuntMassScale * 2), 0.4, 1)
	local vel = flingVelocity(t.humanoid and S.NpcDistance or S.ObjectDistance, dir) * factor
	local ts = THROW_SPIN[S.ThrowSpin]
	local done = {}
	for _, p in ipairs(collectParts(t)) do
		local r = p.AssemblyRootPart
		if r and not done[r] and not r.Anchored then
			done[r] = true
			r.AssemblyLinearVelocity = vel
			local ang = Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5).Unit * ts
			if spinAxis and S.AutoSpin then
				ang += spinAxis * S.SpinSpeed * 2
			end
			r.AssemblyAngularVelocity = ang
		end
	end
	ST.fovKick = 9
	zeroG(t)
	ST.trackImpacts(t)
end

function freezeTarget(t)
	if not t or not t.root then
		return
	end
	local root = t.root
	local fs = frozenStates[root]
	if fs then
		frozenStates[root] = nil
		for p, st in pairs(fs.parts) do
			frozenParts[p] = nil
			if p.Parent then
				p.Anchored = st.anchored
				if not p.Anchored then
					p.AssemblyLinearVelocity = st.linear
					p.AssemblyAngularVelocity = st.angular
				end
			end
		end
		if fs.hl then
			fs.hl:Destroy()
		end
		if t.humanoid then
			scheduleRecover(t)
		end
		toast("Unfrozen", true)
		return
	end
	if not alive(t) then
		return
	end
	local state = {}
	for _, p in ipairs(collectParts(t)) do
		if p:IsA("BasePart") and not p.Anchored then
			state[p] = { anchored = p.Anchored, linear = p.AssemblyLinearVelocity, angular = p.AssemblyAngularVelocity }
			p.AssemblyLinearVelocity = Vector3.zero
			p.AssemblyAngularVelocity = Vector3.zero
			p.Anchored = true
			frozenParts[p] = root
		end
	end
	local hl = Instance.new("Highlight")
	hl.FillColor = Color3.fromRGB(120, 200, 255)
	hl.OutlineColor = Color3.fromRGB(220, 245, 255)
	hl.FillTransparency = 0.6
	hl.Adornee = t.model or root
	hl.Parent = Workspace
	frozenStates[root] = { parts = state, hl = hl, t = t }
	toast("Frozen - aim at it and press G to unfreeze", true)
end

function ST.freezeAim()
	if holding then
		local t = holding
		releaseHold(true)
		freezeTarget(t)
		return
	end
	if pulling then
		local t = pulling
		stopPull()
		freezeTarget(t)
		return
	end
	local t = findTarget(S.Range)
	if t then
		freezeTarget(t)
		return
	end
	local res = castAim(S.Range)
	local root = res and frozenParts[res.Instance]
	if root and frozenStates[root] then
		freezeTarget(frozenStates[root].t)
		return
	end
	toast("Aim at something first")
end

function ST.unfreezeAll()
	local list = {}
	for _, fs in pairs(frozenStates) do
		table.insert(list, fs.t)
	end
	if #list == 0 then
		toast("Nothing is frozen")
		return
	end
	for _, t in ipairs(list) do
		freezeTarget(t)
	end
end

do
	function ST.trackImpacts(t)
		if not (S.ImpactRagdoll or S.ImpactDamage) then
			return
		end
		local conns, hitAt = {}, {}
		for i, p in ipairs(collectParts(t)) do
			if i > 24 then
				break
			end
			table.insert(
				conns,
				p.Touched:Connect(function(hit)
					if not t.root or not t.root.Parent then
						return
					end
					local v = t.root.AssemblyLinearVelocity
					local speed = v.Magnitude
					if speed < 40 then
						return
					end
					local other = resolveTarget(hit)
					if not other or not other.humanoid or other.root == t.root or other.model == t.model then
						return
					end
					local now = os.clock()
					if hitAt[other.root] and now - hitAt[other.root] < 0.5 then
						return
					end
					hitAt[other.root] = now
					if S.ImpactRagdoll then
						setRagdoll(other, true)
						local push = v.Unit * speed * (S.ImpactPower / 100) + Vector3.new(0, speed * 0.1, 0)
						for _, part in ipairs(collectParts(other)) do
							local r = part.AssemblyRootPart
							if r and not r.Anchored then
								r.AssemblyLinearVelocity = push
							end
						end
						scheduleRecover(other)
					end
					if S.ImpactDamage and other.humanoid.Health > 0 then
						other.humanoid:TakeDamage(math.clamp(speed * 0.25, 5, 80))
					end
					shockwave(hit.Position, 6)
				end)
			)
		end
		task.delay(4, function()
			for _, c in ipairs(conns) do
				c:Disconnect()
			end
		end)
	end
end

local function tryGrab(t, dist)
	if not t then
		return
	end
	if t.mass > CONFIG.MaxMass then
		playSound("Deny")
		toast("Too heavy")
		return
	end
	if dist <= CONFIG.GrabRange then
		grab(t)
	else
		startPull(t)
	end
end

function grabToggle()
	if not equipped then
		return
	end
	if holding then
		releaseHold()
		playSound("Drop")
		return
	end
	if pulling then
		stopPull()
		return
	end
	local t, res, off = findTarget(S.Range)
	if t and frozenStates[t.root] then
		toast("Frozen - press G to unfreeze")
		return
	end
	if not t then
		if res then
			playSound("Deny")
			toast(res.Instance.Anchored and "That's anchored" or "Can't grab that")
		end
		return
	end
	tryGrab(t, res.Distance - off)
end

function punt()
	if not equipped then
		return
	end
	local dir = camera.CFrame.LookVector
	recoil = 1
	flash = 1

	if holding then
		playSound("Punt")
		local t = holding
		local pos = t.root.Position
		local axis = axisVec(S.SpinAxis)
		releaseHold(true)
		launch(t, dir, axis)
		shockwave(pos, 8)
		return
	end
	stopPull()
	playSound("Fire")

	local t, res = findTarget(S.Range)
	if not res then
		return
	end
	if t then
		if t.humanoid then
			setRagdoll(t, true)
			scheduleRecover(t)
		end
		claim(t, true)
		if ownershipRemote then
			task.wait(0.25)
		end
		if alive(t) then
			launch(t, dir)
		end
		claim(t, false)
		shockwave(res.Position, 12)
	else
		shockwave(res.Position, 5)
	end
end

