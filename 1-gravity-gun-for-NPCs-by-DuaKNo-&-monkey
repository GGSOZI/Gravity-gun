-- Some games delete every unknown ScreenGui the moment it lands in PlayerGui
-- ("Something unexpectedly tried to set the parent of GravityGunUI to NULL").
-- So every GUI of this script is mounted in the executor's protected container
-- (gethui / CoreGui) first, and PlayerGui is only the fallback.
local GUI_HOST
do
	local host
	pcall(function()
		if gethui then
			host = gethui()
		end
	end)
	if not host then
		pcall(function()
			host = game:GetService("CoreGui")
			local _ = host.Name
		end)
	end
	GUI_HOST = host
end
local function mountGui(g)
	pcall(function()
		if syn and syn.protect_gui then
			syn.protect_gui(g)
		end
	end)
	local targets = {}
	if GUI_HOST then
		table.insert(targets, GUI_HOST)
	end
	table.insert(targets, player:WaitForChild("PlayerGui"))
	for _, h in ipairs(targets) do
		local ok = pcall(function()
			g.Parent = h
		end)
		if ok and g.Parent == h then
			return true
		end
	end
	return false
end

