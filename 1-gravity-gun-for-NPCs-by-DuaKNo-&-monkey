local function fmtNum(n)
	if n >= 100000 then
		return string.format("%.0fk", n / 1000)
	elseif n >= 1000 then
		return string.format("%.1fk", n / 1000)
	end
	return string.format("%.1f", n)
end

RunService.RenderStepped:Connect(function(dt)
	if shared.GG_RUN ~= TP.run then
		return
	end
	local t = os.clock()
	updateMouseLock()
	TP.update(dt)
	SH.update(dt)

	if THEMES[S.Theme].rainbow then
		setAccent(Color3.fromHSV((t * 0.18) % 1, 0.75, 1), true)
	end

	local activeAmt = (holding or pulling) and 1 or (currentAim and 0.35 or 0)
	open = lerp(open, equipped and activeAmt or 0, 1 - math.exp(-dt * 12))
	recoil = lerp(recoil, 0, 1 - math.exp(-dt * 9))
	flash = lerp(flash, 0, 1 - math.exp(-dt * 7))

	PG.updateBeam()
	local live = PG.live
	if live and live.attached and live.handle.Parent then
		local moving = recoil > 0.002
		if PG.dirty or moving or PG.recoilWas then
			PG.recoilWas = moving
			PG.dirty = false
			PG.pose(recoil * 0.35)
		end
	end
	if muzzleLight then
		muzzleLight.Enabled = equipped
		muzzleLight.Brightness = 0.6 + open * 1.4 + flash * 3
	end
	if beam1 and beam1.Enabled then
		beam1.CurveSize0 = math.sin(t * 23) * 1.6
		beam1.CurveSize1 = 0
		beam2.CurveSize0 = math.cos(t * 41) * 2.4
		beam2.CurveSize1 = 0
		local b3 = PG.beam3
		if b3 and b3.Enabled then
			b3.CurveSize0 = math.sin(t * 29 + 1) * 2.2
			b3.CurveSize1 = 0
			b3.Width0 = 0.25 + 0.1 * math.sin(t * 18)
			b3.Width1 = 0.5 + 0.15 * math.sin(t * 14)
		end
	end

	if not equipped then
		return
	end

	local locked = (currentAim ~= nil) and 1 or 0
	local busy = (holding or pulling) and 1 or 0
	crossLock = lerp(crossLock, locked, 1 - math.exp(-dt * 14))
	local targetSpread = 26 - crossLock * 9 + busy * 6 + flash * 8
	crossSpread = lerp(crossSpread, targetSpread, 1 - math.exp(-dt * 16))
	crossSpin = (crossSpin + dt * (busy > 0 and 160 or 0)) % 360
	cross.Rotation = crossSpin + crossLock * 45
	for _, tk in ipairs(ticks) do
		tk.frame.Position = UDim2.new(0.5, tk.dx * crossSpread, 0.5, tk.dy * crossSpread)
	end
	local rs = 34 - crossLock * 8 + busy * 10
	crossRing.Size = UDim2.fromOffset(rs, rs)

	aimTimer += dt
	if aimTimer > 0.05 and not holding and not pulling then
		aimTimer = 0
		local tgt, res, off = findTarget(S.Range)
		currentAim = tgt
		if tgt then
			local heavy = tgt.mass > CONFIG.MaxMass
			highlight.Adornee = S.HighlightTarget and (tgt.model or tgt.root) or nil
			setCrossColor(heavy and Color3.fromRGB(255, 70, 60) or accent)
			if S.ShowTags and not tgt.humanoid then
				tag.Adornee = tgt.root
				tag.Enabled = true
				tagName.Text = tgt.name or "Object"
				tagInfo.Text = string.format("mass %s  |  %d studs", fmtNum(tgt.mass), res and math.floor(res.Distance - off) or 0)
			else
				tag.Enabled = false
			end
		else
			highlight.Adornee = nil
			tag.Enabled = false
			setCrossColor(WHITE)
		end
	elseif holding or pulling then
		currentAim = nil
		highlight.Adornee = nil
		setCrossColor(accent)
		local cur = holding or pulling
		if S.ShowTags and cur and cur.root and not cur.humanoid then
			tag.Adornee = cur.root
			tag.Enabled = true
			tagName.Text = cur.name or "Object"
			tagInfo.Text = string.format(
				"mass %s  |  %d studs",
				fmtNum(cur.mass or 0),
				math.floor((cur.root.Position - camera.CFrame.Position).Magnitude)
			)
		else
			tag.Enabled = false
		end
	end

	if pulling then
		local tgt = pulling
		if not alive(tgt) or os.clock() - pullStart > CONFIG.PullTimeout then
			stopPull()
		else
			local pos = holdPosition(tgt)
			local diff = pos - tgt.root.Position
			local d = diff.Magnitude
			if not tgt.pullStartPos then
				tgt.pullStartPos = tgt.root.Position
			end
			if os.clock() - pullStart > 1.5 and (tgt.root.Position - tgt.pullStartPos).Magnitude < 1 then
				stopPull()
				tgt.pullStartPos = nil
				playSound("Deny")
				toast(ownershipRemote and "Can't move that" or "Can't move that (server-owned)")
			elseif d < math.max(7, tgt.radius * 0.5) then
				grab(tgt)
			else
				local desired = diff.Unit * math.clamp(d * 3, 28, CONFIG.PullSpeedMax)
				tgt.root.AssemblyLinearVelocity = tgt.root.AssemblyLinearVelocity:Lerp(desired, 0.3)
			end
		end
	end

	if holding then
		local tgt = holding
		if not alive(tgt) then
			releaseHold()
		else

			if not panelOpen then
				local dirR = mobileRot
				if UserInputService:IsKeyDown(CONFIG.RotRightKey) then dirR += 1 end
				if UserInputService:IsKeyDown(CONFIG.RotLeftKey) then dirR -= 1 end
				if UserInputService:IsGamepadButtonDown(Enum.UserInputType.Gamepad1, Enum.KeyCode.ButtonR1) then dirR += 1 end
				if UserInputService:IsGamepadButtonDown(Enum.UserInputType.Gamepad1, Enum.KeyCode.ButtonL1) then dirR -= 1 end
				if dirR ~= 0 then
					local kind
					if UserInputService:IsKeyDown(CONFIG.RollKey) then
						kind = 3
					elseif UserInputService:IsKeyDown(CONFIG.PitchKey) then
						kind = 2
					elseif UserInputService.KeyboardEnabled and mobileRot == 0 then
						kind = 1
					else
						kind = S.SpinAxis
					end
					rotateHeld(tgt, axisVec(kind), math.clamp(dirR, -1, 1) * S.RotSpeed * dt)
				end
			end

			if S.AutoSpin then
				rotateHeld(tgt, axisVec(S.SpinAxis), S.SpinSpeed * dt)
			end

			if holdAP then
				holdAP.Responsiveness = S.Snappiness
				holdAO.Responsiveness = math.clamp(S.Snappiness * 0.7, 8, 70)
			end

			local pos = holdPosition(tgt)
			holder.CFrame = CFrame.new(pos) * heldRotation(tgt)
			if (tgt.root.Position - pos).Magnitude > CONFIG.BreakDistance then
				releaseHold()
				playSound("Drop")
				toast("Lost grip")
			end
		end
	end

	if holding and S.ShowArc and alive(holding) then
		ARC.timer += dt
		if ARC.timer > 0.04 then
			ARC.timer = 0
			ARC.update(holding)
		end
	elseif ARC.shown then
		ARC.hide()
	end

	if grabBtn then
		grabBtn.Text = holding and "Drop" or (pulling and "Cancel" or "Grab")
	end

	hudTimer += dt
	if hudTimer > 0.1 then
		hudTimer = 0
		local state, chip = "Ready", DIM
		if panelOpen then
			state = "Options"
		elseif holding then
			state, chip = "Holding", Color3.fromRGB(125, 205, 145)
		elseif pulling then
			state, chip = "Pulling", Color3.fromRGB(110, 225, 255)
		elseif currentAim then
			state, chip = "Locked", accent
		end
		UI.status.Text = state
		UI.status.TextColor3 = chip
		local R = UI.rows
		local cur = holding or pulling or currentAim
		if cur and cur.root then
			R.target.Text = cur.name or "Object"
			R.mass.Text = fmtNum(cur.mass or 0)
			R.dist.Text = string.format("%d studs", math.floor((cur.root.Position - camera.CFrame.Position).Magnitude))
		else
			R.target.Text, R.mass.Text, R.dist.Text = "-", "-", "-"
		end
		R.hold.Text = string.format("%.0f studs", holdDist)
		UI.holdFill.Size = UDim2.fromScale(
			math.sqrt(math.clamp((holdDist - CONFIG.MinHoldDistance) / (CONFIG.MaxHoldDistance - CONFIG.MinHoldDistance), 0, 1)),
			1
		)
		R.npc.Text = string.format("%d studs", S.NpcDistance)
		R.obj.Text = string.format("%d studs", S.ObjectDistance)
	end
end)

